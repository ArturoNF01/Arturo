# ----------------------------------------------------------------------
# Base de datos · PostgreSQL
# En DigitalOcean, la cadena de Connection Details. Trae sslmode=require.
# ----------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:clave@host:25060/defaultdb?sslmode=require

# Conexiones por instancia. El valor por omisión (8) va bien salvo que se
# suban muchas instancias contra una base pequeña.
# BD_CONEXIONES_MAXIMAS=8

# ----------------------------------------------------------------------
# Google (Sheets + Drive) · cuenta de servicio
# El correo de la cuenta de servicio debe tener acceso de editor a la hoja
# y a la carpeta de Drive.
# ----------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=registro-congreso@proyecto.iam.gserviceaccount.com
# Clave privada con los saltos de línea escapados como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ----------------------------------------------------------------------
# Correo (Resend)
# El dominio del remitente tiene que estar verificado en Resend. El correo
# de contacto también se edita desde el panel, así que este valor es sólo
# el punto de partida.
# ----------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CORREO_REMITENTE="Congreso CIESS <congreso@ciess.org>"
CORREO_CONTACTO=congreso@ciess.org

# ----------------------------------------------------------------------
# Recordatorios programados
# Secreto con el que el trabajo programado se autentica ante
# /api/recordatorios. Cualquier cadena larga y aleatoria sirve.
# ----------------------------------------------------------------------
CRON_SECRET=cadena-larga-y-aleatoria

# ----------------------------------------------------------------------
# Aplicación
# ----------------------------------------------------------------------
# En producción: https://congreso-dss.ciess.org
NEXT_PUBLIC_URL_SITIO=http://localhost:3000

# Sal para la huella antiabuso del formulario público. Cualquier cadena larga
# al azar. Conviene fijarla para que la huella no cambie entre despliegues.
ANTIABUSO_SAL=
