{
  "name": "congreso-ciess-registro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "sembrar": "tsx --conditions=react-server guiones/sembrar-demostracion.ts",
    "sincronizar": "tsx --conditions=react-server guiones/sincronizar-hoja.ts",
    "crear-usuario": "tsx --conditions=react-server guiones/crear-usuario.ts",
    "esquema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f basedatos/esquema.sql",
    "prueba-bd": "tsx --conditions=react-server pruebas/integracion/base-de-datos.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "googleapis": "^144.0.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
