# Copia este archivo a .env y ajusta. NUNCA subas .env a git.

# paper   = dinero simulado con precios reales (sin API key). EMPIEZA AQUI.
# testnet = ordenes de prueba en Binance Spot Testnet (API key de testnet)
# live    = dinero real
MODE=paper

# binance (recomendado). Si tu servidor esta en EE.UU. Binance lo bloquea: usa kraken (solo para paper).
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Solo para testnet / live. Permisos: lectura + trading. SIN retiros.
API_KEY=
API_SECRET=

# Capital inicial simulado (solo paper), en USDT
PAPER_START_USDT=100

# Estrategia: cruce de medias moviles
SMA_FAST=20
SMA_SLOW=50

# Riesgo
RISK_PER_TRADE_PCT=1.0     # % del capital que arriesgas por operacion
STOP_LOSS_PCT=3.0          # stop-loss desde el precio de entrada
TAKE_PROFIT_PCT=6.0        # take-profit desde el precio de entrada
MAX_POSITION_PCT=95        # tope del capital en una sola posicion
DAILY_LOSS_LIMIT_PCT=5.0   # si el dia pierde esto, cierra todo y se detiene hasta manana (UTC)
FEE_PCT=0.1                # comision por operacion

# Cada cuantos segundos revisa el precio
POLL_SECONDS=60

# Alertas por Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Para MODE=live debes escribir exactamente: yes
I_UNDERSTAND_REAL_MONEY=no
